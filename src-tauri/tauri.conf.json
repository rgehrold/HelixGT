{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelixGT",
  "mainBinaryName": "HelixGT",
  "version": "0.1.0",
  "identifier": "com.helixgt.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "HelixGT",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/minimap2.exe",
      "binaries/samtools.exe",
      "binaries/*.dll"
    ]
  }
}
